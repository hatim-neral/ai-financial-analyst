# Copy this file to .streamlit/secrets.toml for local runs (it is git-ignored),
# or paste the same lines into the app's Secrets settings on Streamlit Community Cloud.
# Never commit real keys.
#
# Add as many free keys as you like. The app uses them in this order; when one is rate limited or
# busy it switches to the next at once, and users only ever see "busy, try again in a minute".
# More keys = fewer of those moments. All of these are free and need no card.

# Claude (paid, pay-as-you-go API credit - separate from a claude.ai Pro/Max subscription):
# create a key at https://platform.claude.com/settings/keys and add credit under Billing.
# When set, Claude Opus 5.5 answers first and the free providers below are the backup.
# ANTHROPIC_API_KEY = "sk-ant-your_key_here"

# Groq: https://console.groq.com/keys  (gpt-oss-120b, ~200k tokens/day)
GROQ_API_KEY = "gsk_your_key_here"

# Cerebras: https://cloud.cerebras.ai  (same gpt-oss-120b, ~1M tokens/day)
# CEREBRAS_API_KEY = "csk_your_key_here"

# Mistral: https://console.mistral.ai/api-keys  (free "Experiment" plan)
# MISTRAL_API_KEY = "your_key_here"

# Google Gemini: https://aistudio.google.com/apikey  (free quota is per model per day; two models are used)
# GEMINI_API_KEY = "your_key_here"

# NVIDIA NIM: https://build.nvidia.com  (key starts with nvapi-)
# NVIDIA_API_KEY = "nvapi-your_key_here"

# Hugging Face: https://huggingface.co/settings/tokens  (token with "Make calls to Inference Providers")
# HF_TOKEN = "hf_your_token_here"

# OpenRouter: https://openrouter.ai/keys  (":free" models, ~50 requests/day)
# OPENROUTER_API_KEY = "sk-or-your_key_here"

# Optional overrides. Any *_MODEL may list several models, comma-separated; each gets its own quota.
# LLM_PROVIDER = "anthropic"       # which provider to try first (default: the order of this file)
# ANTHROPIC_MODEL = "claude-opus-5-5"
# GROQ_MODEL = "openai/gpt-oss-120b"
# CEREBRAS_MODEL = "gpt-oss-120b"
# MISTRAL_MODEL = "mistral-small-latest"
# GEMINI_MODEL = "gemini-3.5-flash-lite,gemini-3.5-flash"
# NVIDIA_MODEL = "moonshotai/kimi-k2.6"
# HF_MODEL = "openai/gpt-oss-120b"
# OPENROUTER_MODEL = "nvidia/nemotron-3-super-120b-a12b:free"
