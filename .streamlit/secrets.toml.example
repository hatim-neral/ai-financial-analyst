# Copy this file to .streamlit/secrets.toml for local runs (it is git-ignored),
# or paste the same lines into the app's Secrets settings on Streamlit Community Cloud.
# Never commit real keys.

# Primary provider (free key, no card: https://console.groq.com/keys)
GROQ_API_KEY = "gsk_your_key_here"

# Optional fallback provider (free key: https://aistudio.google.com/apikey)
# GEMINI_API_KEY = "your_key_here"

# Optional overrides
# LLM_PROVIDER = "groq"            # or "gemini"
# GROQ_MODEL = "llama-3.3-70b-versatile"
# GEMINI_MODEL = "gemini-2.5-flash"
